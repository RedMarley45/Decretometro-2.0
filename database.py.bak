        cursor.execute('''
            UPDATE cobro_reserva_usos_recuperos
            SET monto = ?, fecha = ?, destino_tipo = ?, destino_detalle = ?, decreto_destino_id = ?, nro_op = ?, notas = ?
            WHERE id = ?
        ''', (monto, fecha, destino_tipo, destino_detalle, decreto_destino_id, nro_op, notas, rec_id))
